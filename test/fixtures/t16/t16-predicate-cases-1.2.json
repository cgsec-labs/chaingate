{
 "version": "t16-predicates-1.2",
 "about": "T1.6 entry-path-change predicate cases: a version manifest (package.json fields name, scripts, bin, main) and its predecessor's -> the components that fire. ONE fixture for the Python measurement (tools/corpus/base_rates.py), the proxy tests and the recon tests (mirrors load it unchanged and assert the same version string). Components: lifecycle_added (a non-install lifecycle script name absent before), lifecycle_changed (present in both, text differs), bin_added (a bin command absent before), bin_changed (same command, different path), main (the entry point differs after normalisation: absent or empty main = index.js; leading './' stripped (and any '/' after it, as Node resolves './/x' = 'x'); a main that starts with '/' is an absolute path to Node and is kept as written, so '/x' vs 'x' is a change and '/x' vs '/x' is not; a bare final segment without an extension = the same path + '.js'. Directory moves and .js/.cjs/.mjs/.ts changes stay changes. An absolute main is not a flag on its own. t16-predicates-1.2 (orchestrator verdict 2026-10-16 15:05Z; 1.1 stripped a leading '/'). Lifecycle names = collector/install_scripts.py LIFECYCLE_HOOKS (install hooks preinstall/install/postinstall are T1.1, not T1.6). The predecessor is chosen elsewhere (FU-2 lineage); these cases judge one pair.",
 "lifecycle_names": [
  "prepare",
  "preprepare",
  "postprepare",
  "prepack",
  "postpack",
  "prepublish",
  "prepublishOnly",
  "publish",
  "postpublish",
  "preuninstall",
  "uninstall",
  "postuninstall",
  "dependencies"
 ],
 "cases": [
  {
   "id": "no-change",
   "before": {
    "name": "p",
    "main": "index.js",
    "scripts": {
     "test": "jest"
    }
   },
   "after": {
    "name": "p",
    "main": "index.js",
    "scripts": {
     "test": "mocha"
    }
   },
   "expect": []
  },
  {
