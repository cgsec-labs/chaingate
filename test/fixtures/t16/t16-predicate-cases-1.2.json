    "scripts": {
     "build": "tsc"
    }
   },
   "after": {
    "name": "p",
    "scripts": {
     "build": "tsc",
     "prepare": "node setup.js"
    }
   },
   "expect": [
    "lifecycle_added"
   ]
  },
  {
   "id": "prepare-changed",
   "before": {
    "name": "p",
    "scripts": {
